# Copy to .env.local for development; set the same names in Vercel (Project Settings > Environment Variables).
# Placeholders only. Never commit real values.

# Public site URL (canonical links, sitemap)
NEXT_PUBLIC_SITE_URL=https://example.com
# Set to "false" to hide the "video not generated yet" notes on heroes
NEXT_PUBLIC_SHOW_PLACEHOLDER_NOTES=true

# Email delivery of the PDF estimate and lead notifications (server-side only)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Studio Name <no-reply@example.com>"
# Studio inbox that receives consultation requests and estimate leads
NOTIFY_TO=

# WhatsApp sharing: studio number, international format digits only (public by nature)
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Video generation (server/CLI only; NEVER prefix with NEXT_PUBLIC_)
MUAPI_API_KEY=

# ---- Studio OS (admin, employees, projects, documents, CMS) ----
# Postgres connection string. Provisioned by the Vercel Marketplace Neon integration (DATABASE_URL).
DATABASE_URL=
# Vercel Blob store (private) used for uploaded files and CMS media. Added automatically when the store is connected.
BLOB_READ_WRITE_TOKEN=
# One-time key needed on /admin/setup to create the first Main Admin. Use 24+ random characters. Keep it secret.
SETUP_TOKEN=
# Local development only: LOCAL_DB=pglite runs an embedded Postgres so you can work without a cloud database.
LOCAL_DB=
