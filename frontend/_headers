# Security and cache headers for hosts that read a "_headers" file (Netlify, Cloudflare Pages).
# For another host, set the same headers in its configuration. Replace https://api.example.com with your API origin.

/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://api.example.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=()
  X-Frame-Options: DENY

# File names are not content-hashed, so images and fonts are cached for 30 days and code is revalidated on each visit.
/assets/images/*
  Cache-Control: public, max-age=2592000

/assets/fonts/*
  Cache-Control: public, max-age=2592000

/assets/css/*
  Cache-Control: no-cache

/assets/js/*
  Cache-Control: no-cache

/assets/data/*
  Cache-Control: public, max-age=3600

/admin/*
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow
